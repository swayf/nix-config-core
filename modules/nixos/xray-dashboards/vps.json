{
  "uid": "xray-vps",
  "title": "Xray VPS — local observer",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "templating": {"list": [{"name": "node", "type": "query", "datasource": {"type": "prometheus", "uid": "prometheus"}, "query": "label_values(up, node)", "refresh": 1}]},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Exporter HTTP and Xray StatsService (distinct checks)", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}, "targets": [{"expr": "up{node=\"$node\"}", "legendFormat": "HTTP {{job}}"}, {"expr": "xray_up{node=\"$node\"}", "legendFormat": "Xray stats"}]},
    {"id": 2, "type": "timeseries", "title": "Local readiness (not an external host check)", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}, "targets": [{"expr": "probe_success{node=\"$node\",job=\"monitoring-health\"}", "legendFormat": "{{service}}"}, {"expr": "node_systemd_unit_state{node=\"$node\",state=\"active\"}", "legendFormat": "{{name}} active"}]},
    {"id": 3, "type": "timeseries", "title": "Resources: CPU / RAM / swap / root space / inodes used", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "fieldConfig": {"defaults": {"unit": "percentunit"}}, "targets": [{"expr": "1 - avg(rate(node_cpu_seconds_total{node=\"$node\",mode=\"idle\"}[5m]))", "legendFormat": "CPU"}, {"expr": "1 - node_memory_MemAvailable_bytes{node=\"$node\"}/node_memory_MemTotal_bytes{node=\"$node\"}", "legendFormat": "RAM"}, {"expr": "1 - node_memory_SwapFree_bytes{node=\"$node\"}/node_memory_SwapTotal_bytes{node=\"$node\"}", "legendFormat": "swap"}, {"expr": "1 - node_filesystem_avail_bytes{node=\"$node\",mountpoint=\"/\",fstype!~\"tmpfs|rootfs\"}/node_filesystem_size_bytes{node=\"$node\",mountpoint=\"/\",fstype!~\"tmpfs|rootfs\"}", "legendFormat": "root space"}, {"expr": "1 - node_filesystem_files_free{node=\"$node\",mountpoint=\"/\",fstype!~\"tmpfs|rootfs\"}/node_filesystem_files{node=\"$node\",mountpoint=\"/\",fstype!~\"tmpfs|rootfs\"}", "legendFormat": "root inodes"}]},
    {"id": 4, "type": "timeseries", "title": "Xray uptime and observed restarts", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}, "targets": [{"expr": "xray_uptime_seconds{node=\"$node\"}", "legendFormat": "uptime seconds"}, {"expr": "resets(xray_uptime_seconds{node=\"$node\"}[15m])", "legendFormat": "uptime decreases / 15m"}, {"expr": "increase(node_systemd_service_restart_total{node=\"$node\",name=\"xray.service\"}[15m])", "legendFormat": "automatic restarts / 15m"}]},
    {"id": 5, "type": "timeseries", "title": "Client traffic rate (bytes/s)", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8}, "fieldConfig": {"defaults": {"unit": "Bps"}}, "targets": [{"expr": "rate(xray_traffic_uplink_bytes_total{node=\"$node\",dimension=\"user\"}[5m])", "legendFormat": "{{target}} up"}, {"expr": "rate(xray_traffic_downlink_bytes_total{node=\"$node\",dimension=\"user\"}[5m])", "legendFormat": "{{target}} down"}]},
    {"id": 6, "type": "timeseries", "title": "Client observed volume in selected range (not billing)", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8}, "fieldConfig": {"defaults": {"unit": "bytes"}}, "targets": [{"expr": "increase(xray_traffic_uplink_bytes_total{node=\"$node\",dimension=\"user\"}[$__range])", "legendFormat": "{{target}} up"}, {"expr": "increase(xray_traffic_downlink_bytes_total{node=\"$node\",dimension=\"user\"}[$__range])", "legendFormat": "{{target}} down"}]},
    {"id": 7, "type": "timeseries", "title": "Inbound / outbound rate — separate views, do not sum together", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8}, "fieldConfig": {"defaults": {"unit": "Bps"}}, "targets": [{"expr": "rate(xray_traffic_uplink_bytes_total{node=\"$node\",dimension=~\"inbound|outbound\"}[5m])", "legendFormat": "{{dimension}} {{target}} up"}, {"expr": "rate(xray_traffic_downlink_bytes_total{node=\"$node\",dimension=~\"inbound|outbound\"}[5m])", "legendFormat": "{{dimension}} {{target}} down"}]},
    {"id": 8, "type": "timeseries", "title": "Collection errors and firing alerts", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 12, "y": 24, "w": 12, "h": 8}, "targets": [{"expr": "xray_scrape_duration_seconds{node=\"$node\"}", "legendFormat": "Xray scrape seconds"}, {"expr": "node_scrape_collector_success{node=\"$node\"} == 0", "legendFormat": "failed {{collector}}"}, {"expr": "ALERTS{node=\"$node\",alertstate=\"firing\"}", "legendFormat": "{{alertname}}"}]}
  ]
}
